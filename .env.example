# ─── Database (required) ────────────────────────────────────────
# On Railway: add a Postgres service, then reference it here as
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally: run Postgres and point at it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paisawise

# Max Postgres connections this instance will open. Keep
# (PG_POOL_MAX x replicas) below your Postgres max_connections.
PG_POOL_MAX=10

# ─── AI (required for the assistant) ────────────────────────────
# Free Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=your_api_key_here
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.0-flash

# ─── Runtime ────────────────────────────────────────────────────
# Railway injects PORT automatically — do not hardcode it in production.
NODE_ENV=production

# ─── Deployment / security ──────────────────────────────────────
# Number of proxies YOU control in front of the app. Render/Railway/Fly = 1,
# add 1 more if behind Cloudflare. Used to read the real client IP safely.
TRUSTED_PROXY_HOPS=1

# Optional: CA certificate for full database TLS verification.
# Neon and Supabase use publicly trusted certs and need nothing here.
# DATABASE_CA_CERT=

# Lets visitors switch to Pro without paying, to demo quota behaviour.
ALLOW_DEMO_UPGRADE=true
